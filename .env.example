# Required Telegram credentials. Create a separate bot in @BotFather.
GUEST_BOT_TOKEN=replace_with_your_bot_token
# Numeric Telegram user ID allowed to invoke this owner-only bot.
GUEST_OWNER_ID=123456789
GUEST_BOT_USERNAME=your_guest_bot_username

# Your Hermes endpoint or any OpenAI-compatible Chat Completions endpoint.
# In Docker, host.docker.internal reaches the host on Docker Desktop and the
# Compose extra_hosts rule makes the same name work on modern Linux Docker.
HERMES_API_URL=http://host.docker.internal:8643/v1/chat/completions
HERMES_API_KEY=replace_with_your_harness_api_key
HERMES_MODEL=your-model-name

# Hermes Runs API is preferred: the harness owns the session using a stable
# session_id. Set to 0 for a standard Chat Completions-only harness; the
# gateway then maintains a bounded, in-memory reply transcript for 120 seconds.
HERMES_USE_RUNS=1
GUEST_HERMES_MAX_RUNTIME=900
HERMES_RUN_START_TIMEOUT=30
HERMES_POLL_TIMEOUT=20
HERMES_POLL_INTERVAL=1
HERMES_TIMEOUT=300

# Inbound media is written to this directory. With Docker Compose, it is
# overridden to /sandbox/inbound inside the container.
GUEST_MEDIA_ENABLED=1
GUEST_MEDIA_CACHE_DIR=runtime/guest-media-cache
# Optional absolute host path visible to a host-side harness. run-docker.sh
# derives this from the active checkout so a moved deployment cannot retain a
# stale path. Set it manually only for direct Python or raw Compose launches.
GUEST_MEDIA_HOST_DIR=
GUEST_MEDIA_MAX_BYTES=10000000

# Optional host directory where the harness writes generated images/files.
# The Hermes bootstrap fills this with that profile's cache/images directory.
# Compose mounts only this directory read-only; it never exposes the profile,
# credentials, SOUL.md, skills, or history to the Telegram sidecar.
GUEST_HARNESS_MEDIA_DIR=

# Require Telegram-native MTProto transcription through an installed userbot
# skill whenever original chat/message/sender provenance is available. This
# prevents silent Whisper/Ollama/ffmpeg fallbacks for Telegram voice summaries.
GUEST_TELEGRAM_NATIVE_STT_REQUIRED=1

# Enrich explicit avatar/profile-photo tasks from an exact reply author or
# text_mention user. Arbitrary @username resolution remains a Userbot job.
GUEST_PROFILE_PHOTO_ENABLED=1

# Retry one explicit media task when the first harness answer produced no
# verified allowlisted artifact. This is a single correction, never a loop.
GUEST_TOOL_RECOVERY_ENABLED=1

# With Docker Compose, generated files must be placed in the host directory
# mapped to runtime/guest-media-cache. The container allowlist is therefore
# /sandbox/inbound. Override this for direct Python execution only.
GUEST_OWNER_MEDIA_ENABLED=1
# Compose supplies /sandbox/inbound:/sandbox/harness-output. Set this manually
# only for direct Python execution.
GUEST_OWNER_MEDIA_ALLOWED_DIRS=/sandbox/inbound

GUEST_REACTIONS_ENABLED=false
GUEST_RICH_MESSAGES_ENABLED=1
GUEST_RICH_MAX_REPLY_CHARS=30000
GUEST_TEXT_MAX_REPLY_CHARS=3900

GUEST_PLACEHOLDER_ENABLED=1
GUEST_PLACEHOLDER_TEXT=Думаю…
# Optional. Leave empty to use ordinary text instead of a Telegram custom emoji.
GUEST_PLACEHOLDER_CUSTOM_EMOJI_ID=
GUEST_PLACEHOLDER_CUSTOM_EMOJI_ALT=🤔
# Replace the placeholder with privacy-safe activity from Hermes Runs SSE.
# Tool names, arguments, commands, URLs, and local paths are never shown.
GUEST_PROGRESS_ENABLED=1
# Minimum delay between Telegram status edits (bounded to 0.5-10 seconds).
GUEST_PROGRESS_MIN_INTERVAL=1.0
# Refresh a long-running activity with another safe phase (bounded to 2-30 seconds).
GUEST_PROGRESS_HEARTBEAT_INTERVAL=4.0
GUEST_FINAL_DELIVERY_MODE=edit
GUEST_PLACEHOLDER_DONE_TEXT=Готово.

# How long a reply may continue the preceding Guest Agent response.
GUEST_PENDING_ANCHOR_TTL=120

# Docker bind-mount ownership. init-env.sh appends the current host UID/GID.
# Set these manually only if you deliberately run Docker as another host user.

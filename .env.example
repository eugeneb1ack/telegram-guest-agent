# Required Telegram credentials. Create a separate bot in @BotFather.
GUEST_BOT_TOKEN=replace_with_your_bot_token
# Numeric Telegram user ID allowed to invoke this owner-only bot.
GUEST_OWNER_ID=123456789
GUEST_BOT_USERNAME=your_guest_bot_username

# Your Hermes endpoint or any OpenAI-compatible Chat Completions endpoint.
# In Docker, host.docker.internal reaches the host on Docker Desktop and the
# Compose extra_hosts rule makes the same name work on modern Linux Docker.
HERMES_API_URL=http://host.docker.internal:8643/v1/chat/completions
HERMES_API_KEY=replace_with_your_harness_api_key
HERMES_MODEL=your-model-name

# Hermes Runs API is preferred: the harness owns the session using a stable
# session_id. Set to 0 for a standard Chat Completions-only harness; the
# gateway then maintains a bounded, in-memory reply transcript for 120 seconds.
HERMES_USE_RUNS=1
GUEST_HERMES_MAX_RUNTIME=900
HERMES_RUN_START_TIMEOUT=30
HERMES_POLL_TIMEOUT=20
HERMES_POLL_INTERVAL=3
HERMES_TIMEOUT=300

# Inbound media is written to this directory. With Docker Compose, it is
# overridden to /sandbox/inbound inside the container.
GUEST_MEDIA_ENABLED=1
GUEST_MEDIA_CACHE_DIR=runtime/guest-media-cache
# Optional absolute host path visible to your harness for files downloaded by
# the container. Leave empty if the harness can use the container path itself.
GUEST_MEDIA_HOST_DIR=
GUEST_MEDIA_MAX_BYTES=10000000

# Local media generated by the harness can be staged via owner DM only when it
# belongs to one of these explicitly allowed directories. Use your own absolute
# paths, separated by ':' on macOS/Linux and ';' on Windows.
GUEST_OWNER_MEDIA_ENABLED=1
GUEST_OWNER_MEDIA_ALLOWED_DIRS=runtime/guest-media-cache

GUEST_REACTIONS_ENABLED=false
GUEST_RICH_MESSAGES_ENABLED=1
GUEST_RICH_MAX_REPLY_CHARS=30000
GUEST_TEXT_MAX_REPLY_CHARS=3900

GUEST_PLACEHOLDER_ENABLED=1
GUEST_PLACEHOLDER_TEXT=Думаю…
# Optional. Leave empty to use ordinary text instead of a Telegram custom emoji.
GUEST_PLACEHOLDER_CUSTOM_EMOJI_ID=
GUEST_PLACEHOLDER_CUSTOM_EMOJI_ALT=🤔
GUEST_FINAL_DELIVERY_MODE=edit
GUEST_PLACEHOLDER_DONE_TEXT=Готово.

# How long a reply may continue the preceding Guest Agent response.
GUEST_PENDING_ANCHOR_TTL=120
